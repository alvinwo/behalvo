{
  "name": "behalvo",
  "version": "0.2.1",
  "description": "Behalvo: a journal-backed agent runtime that acts on your behalf across life and work. Local MVP.",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "demo": "npm run build && node dist/demo.js",
    "check": "npm run typecheck && npm test",
    "agent": "npm run build && node dist/cli/main.js",
    "mvp:demo": "npm run build && node dist/mvp-demo.js",
    "operations:demo": "npm run build && node dist/operations-demo.js"
  },
  "devDependencies": {
    "@types/node": "22.19.7",
    "typescript": "5.8.3"
  }
}
