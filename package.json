{
  "name": "behalvo",
  "version": "0.2.1",
  "description": "Behalvo: a journal-backed agent runtime that acts on your behalf across life and work. Local MVP.",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-control-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "demo": "npm run build && node dist/demo.js",
    "check": "npm run typecheck && npm test",
    "agent": "npm run build && node dist/cli/main.js",
    "storage": "npm run build && node dist/cli/storage-main.js",
    "eval:agent": "npm run build && node dist/evaluation/main.js",
    "mvp:demo": "npm run build && node dist/mvp-demo.js",
    "operations:demo": "npm run build && node dist/operations-demo.js",
    "owner-control": "npm run build && node dist/cli/owner-control-main.js",
    "service": "npm run build && node dist/cli/service-main.js",
    "owner-control:demo": "npm run build && node dist/control-demo.js",
    "verify": "node scripts/verify.mjs"
  },
  "devDependencies": {
    "@types/node": "22.19.7",
    "typescript": "5.8.3"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.85.1"
  }
}
